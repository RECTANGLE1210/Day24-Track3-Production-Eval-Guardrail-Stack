# Required for Day18 RAG generation, RAGAS, LLM Judge and NeMo Guardrails
OPENROUTER_API_KEY=

# OpenRouter API
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_JUDGE_MODEL=openai/gpt-4o-mini

# Optional Hugging Face token
HF_TOKEN=

# Qdrant
# local = embedded Qdrant, no Docker/server required
# server = connect to QDRANT_HOST/QDRANT_PORT
QDRANT_MODE=local

# Optional custom local database location
# QDRANT_LOCAL_PATH=
